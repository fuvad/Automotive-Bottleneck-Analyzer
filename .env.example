APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/bottleneck_analyzer
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=4000
WORKFLOW_MAX_STEPS=10
WORKFLOW_RETRIEVAL_LIMIT=20
SIMULATION_MAX_DAYS=30
SIMULATION_MAX_REPLICATIONS=20
SIMULATION_TIMEOUT_SECONDS=600
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Optional: EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_SECONDS=10
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=automotive-bottleneck-analyzer
DESIGN_PRODUCTION_RATE_JPH=60
ILLUSTRATIVE_ACTUAL_PRODUCTION_RATE_JPH=46
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Local API limits; execution and submission registration are process-local.
API_ADMISSION_TIMEOUT_SECONDS=10
API_MAXIMUM_BODY_BYTES=32768
API_SUBMISSION_HISTORY_LIMIT=100
